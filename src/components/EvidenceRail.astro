---
interface Item {
  value: string;
  label: string;
  tone?: 'signal' | 'flag' | 'neutral';
}

interface Props {
  heading?: string;
  items: Item[];
  /** Hero patches animate on load; everything else waits for the scroll. */
  onLoad?: boolean;
}

const { heading = 'Evidence', items, onLoad = false } = Astro.props;
---

<aside class="evidence">
  <p class="eyebrow">{heading}</p>
  <ul class="rail">
    {
      items.map((item, i) => (
        <li
          class:list={['patch', onLoad ? 'settle' : 'reveal']}
          data-tone={item.tone ?? 'signal'}
          style={onLoad ? `animation-delay:${90 * i}ms` : undefined}
        >
          <span class="value">{item.value}</span>
          <span class="label">{item.label}</span>
        </li>
      ))
    }
  </ul>
</aside>

<style>
  .evidence {
    position: sticky;
    top: 2rem;
  }

  @media (max-width: 59.99rem) {
    .evidence {
      position: static;
    }
  }
</style>
