---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';

// Drop the PDF link in public/ and it appears. No file, no broken link.
const hasPdf = existsSync('public/jeff-liknes-resume.pdf');

// Seeded from master-resume.md, then edited for the web. This is now its own
// copy. Changes to the master resume do not flow here.
const experience = [
  {
    role: 'Web Designer / Developer',
    org: 'Sojern',
    note: 'Joined Myhotelshop GmbH; acquired by RateGain in 2021, moved under the Sojern brand after RateGain’s 2025 acquisition. One continuous role throughout.',
    period: 'April 2021 – present',
    place: 'Leipzig, Germany · remote from Spain',
    points: [
      'Own technical SEO across a 70+ site multilingual (DE/EN) hotel portfolio, including JSON-LD Hotel and LodgingBusiness schema across multiple brands.',
      'Google Tag Manager and consent architecture portfolio-wide: Consent Mode v2 via Cookiebot and consentmanager, GDPR-compliant lazy-loading GTM.',
      'Led the evaluation to move 70 hotel sites off Sitejet onto a headless stack (Astro, Storyblok/TinaCMS, GitHub, Vercel/Cloudflare), with cost models comparing Sitejet, Webflow and a custom build.',
      'Built an AI-assisted build pipeline (Claude Code CLI, Cursor and a headless CMS generating a full site from a single prompt), plus n8n workflows for widget and schema deployment and a Postgres pipeline over the Search Console and Google Ads APIs.',
      'Built and piloted a GEO/AI visibility toolkit scoring hotel domains on their presence in AI answer engines, and set the portfolio GEO strategy.',
      'Authored language-v2.js, resolving a routing conflict with a third-party translation widget across the portfolio; own redirect and URL-routing architecture (301/302/410/415, path vs absolute resolution) across multi-site deployments.',
      'Manage property-manager and hotel-client relationships across German and English-speaking markets; train new designers; present monthly all-hands updates.',
    ],
  },
  {
    role: 'Founder and sole engineer',
    org: 'Balloon Sight Intelligence',
    note: 'Pre-revenue, validating with Alberta and BC contractors.',
    period: 'May 2026 – present',
    place: 'B2B construction-project intelligence for Canadian contractors',
    points: [
      'Nine-source ingestion pipeline normalising Canadian construction projects into one SQLite schema, covering Socrata, ArcGIS REST and OpenDataSoft municipal permit APIs, BC Major Projects, the BC Environmental Assessment registry and federal CanadaBuys, with dedup and per-source incremental fetch state. 3,161 projects tracked.',
      'Eleven Python agent packages (~9,800 lines) running unattended on systemd timers with OnFailure alerting; per-run budget caps added after a hung third-party job exhausted a monthly API quota.',
      'Per-subscriber personalisation reading Stripe profile metadata to filter and rank projects, generating a weekly digest through the Claude API.',
      'Customer-facing product in Next.js 16 / React 19 / TypeScript / Tailwind 4 on Vercel: marketing site, gated sample funnel, Stripe Checkout and subscription onboarding, internal outreach approval dashboard.',
      'CASL-compliant outbound email: verified sending domain, physical-address footer, reply-to-unsubscribe, pre-send suppression checks, daily send cap. Held total running cost to $110–150/month across five paid APIs on a $5 VPS.',
    ],
  },
  {
    role: 'Website design, build and growth',
    org: 'Concrete Genius Mfg.',
    note: 'concretegenius.com · Alberta manufacturer of mobile volumetric concrete mixers and batching plants.',
    period: '2025 – 2026',
    place: 'Remote, solo engagement',
    points: [
      'Designed and shipped an 18-page Astro 5 / TypeScript marketing site, statically generated with no client JS by default, a hand-rolled CSS token system and self-hosted IBM Plex; Sharp image pipeline converting 34 MB of product media to WebP.',
      'Deployed on Vercel with per-branch previews, environment-driven canonicals so previews never leak into the index, and a 16-rule permanent-redirect map preserving link equity through an IA restructure.',
      'Full technical SEO: generated sitemap and robots.txt, canonicals, Open Graph, and JSON-LD across Organization, LocalBusiness, WebSite/SearchAction, Product, Brand and FAQPage. Search Console monitored to prioritise page and copy work.',
      'Built the measurement stack: production-gated GTM, form and call conversion tracking, Consent Mode v2, CookieYes loading ahead of GTM, and the privacy and cookie policies to match.',
      'Ran 18 months of Google and Meta advertising across €13,700 of spend, 205 enquiries, €67 blended cost per enquiry. Found image-led campaigns delivered 44% of enquiries for 35% of spend, stopped a €533-per-enquiry campaign, and paused search rather than keep funding targeting that was wrong from the start.',
    ],
  },
  {
    role: 'Freelance Webflow developer',
    org: 'Independent',
    period: 'February 2018 – present',
    place: 'Remote',
    points: [
      'Figma and Webflow prototypes; content strategy from competitive analysis across Google Analytics, Ahrefs and Search Console.',
      'Keyword analysis and A/B testing for organic growth; on-page and off-page SEO; paid acquisition on Meta and Google Ads.',
    ],
  },
  {
    role: 'Web Designer / Webflow Developer',
    org: 'Catch Digital',
    period: 'November 2020 – April 2021',
    place: 'Calgary, Canada',
    points: [
      'Wireframes from information architecture, prototypes in Figma, builds in Webflow with custom code.',
      'Content strategy through competitive analysis; partnered with copywriters on SEO-driven content.',
    ],
  },
  {
    role: 'Digital Marketing',
    org: 'Flash Virtual Reality Technologies',
    period: 'August 2020 – November 2020',
    place: 'Remote',
    points: [
      'Competitive analysis, Google Ads management and A/B testing, conversion tracking and optimisation in Google Analytics.',
    ],
  },
];

const education = [
  { title: 'Web Development Professional, Diploma', org: 'Red Academy, Vancouver, Canada' },
  { title: 'Business Commerce (incomplete)', org: 'University of Calgary, Canada' },
  { title: 'Deutsch Intensivkurs A1.1 / A1.2 / A2.1', org: 'Salzburg, Austria' },
];
---

<Base
  title="Resume · Jeffrey Liknes"
  description="Eight years across front-end build, technical SEO, tag management and analytics. Full working history, skills and education."
>
  <section class="wrap head">
    <p class="eyebrow">Resume</p>
    <h1>Jeffrey Liknes</h1>
    <p class="lede">
      Eight years across front-end build, technical SEO, tag management and analytics, most
      recently owning the web and marketing stack for a 70+ site multilingual hotel portfolio,
      and building an autonomous data product end to end on the side. I ship the site and then
      own whether it worked.
    </p>
    <dl class="contact">
      <div><dt>Email</dt><dd><a href="mailto:jeff.liknes@gmail.com">jeff.liknes@gmail.com</a></dd></div>
      <div><dt>Phone</dt><dd><a href="tel:+34711014627">+34 711 014 627</a></dd></div>
      <div><dt>Location</dt><dd>Spain · Canadian citizen</dd></div>
      <div><dt>LinkedIn</dt><dd><a href="https://linkedin.com/in/jeff-liknes/">jeff-liknes</a></dd></div>
    </dl>
    {hasPdf && <p class="download"><a href="/jeff-liknes-resume.pdf">Download as PDF</a></p>}
  </section>

  <section class="wrap section">
    <p class="eyebrow">Experience</p>
    <ol class="roles">
      {
        experience.map((job) => (
          <li>
            <div class="role-head">
              <h2>
                {job.role} · {job.org}
              </h2>
              <p class="meta">
                {job.period} · {job.place}
              </p>
              {job.note && <p class="note">{job.note}</p>}
            </div>
            <ul class="points">
              {job.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section">
    <div class="split">
      <div>
        <p class="eyebrow">Education</p>
        <ul class="plain">
          {
            education.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.org}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="eyebrow">Languages</p>
        <ul class="plain">
          <li><strong>English</strong><span>Native</span></li>
          <li><strong>German</strong><span>A2 coursework, working in a German-speaking market</span></li>
          <li><strong>Spanish</strong><span>Resident in Spain</span></li>
        </ul>
      </div>
    </div>
  </section>

  <style>
    .head {
      padding-block: clamp(2.5rem, 7vw, 5rem) clamp(2rem, 5vw, 3.5rem);
    }

    .head h1 {
      margin-bottom: 1.5rem;
    }

    .lede {
      font-size: 1.15em;
      line-height: 1.5;
    }

    .contact {
      display: grid;
      gap: 1rem 2.5rem;
      grid-template-columns: repeat(auto-fit, minmax(13rem, auto));
      justify-content: start;
      margin: 2.5rem 0 0;
      padding-top: 1.5rem;
      border-top: 1px solid var(--rule);
    }

    .contact dt {
      font-family: var(--label);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-soft);
      margin-bottom: 0.3rem;
    }

    .contact dd {
      margin: 0;
      font-family: var(--label);
      font-size: 0.88rem;
    }

    .download {
      font-family: var(--label);
      font-size: 0.85rem;
      margin-top: 1.8rem;
    }

    .roles {
      list-style: none;
      margin: 2rem 0 0;
      padding: 0;
    }

    .roles > li {
      border-top: 1px solid var(--rule);
      padding-block: clamp(1.75rem, 4vw, 2.75rem);
      display: grid;
      gap: 1.25rem clamp(2rem, 5vw, 4rem);
    }

    @media (min-width: 60rem) {
      .roles > li {
        grid-template-columns: 20rem minmax(0, 1fr);
      }
    }

    .roles h2 {
      font-size: clamp(1.1rem, 1rem + 0.5vw, 1.3rem);
      margin-bottom: 0.5rem;
      text-wrap: pretty;
    }

    .meta {
      font-family: var(--label);
      font-size: 0.74rem;
      color: var(--ink-soft);
      margin: 0;
      max-width: none;
    }

    .note {
      font-size: 0.88rem;
      color: var(--ink-soft);
      margin: 0.8rem 0 0;
      max-width: none;
    }

    .points {
      margin: 0;
      padding-left: 1.05rem;
    }

    .points li {
      margin-bottom: 0.65rem;
      max-width: var(--measure);
    }

    .plain {
      list-style: none;
      margin: 1.5rem 0 0;
      padding: 0;
    }

    .plain li {
      border-top: 1px solid var(--rule);
      padding-block: 0.85rem;
      display: grid;
      gap: 0.2rem;
    }

    .plain span {
      font-family: var(--label);
      font-size: 0.78rem;
      color: var(--ink-soft);
    }
  </style>
</Base>
