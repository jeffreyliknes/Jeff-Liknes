---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Work · Jeffrey Liknes"
  description="Case studies in web build, technical SEO, analytics and paid acquisition, each with the numbers it produced."
>
  <section class="wrap head">
    <p class="eyebrow">Work</p>
    <h1>Four projects, and what each one measured.</h1>
    <p class="lede">
      Listed most-defensible first. Where a result is thin or a pilot has not proven itself, the
      entry says so rather than borrowing credibility from the ones that did.
    </p>
  </section>

  <ol class="list wrap">
    {
      work.map((entry) => (
        <li class="split">
          <div>
            {entry.data.image && entry.data.imageAlt && (
              <a class="thumb" href={`/work/${entry.id}/`} tabindex="-1" aria-hidden="true">
                <Image src={entry.data.image} alt="" widths={[420, 840]} sizes="(min-width: 60rem) 40rem, 92vw" />
              </a>
            )}
            <h2>
              <a href={`/work/${entry.id}/`}>{entry.data.title}</a>
            </h2>
            <p class="meta">
              {entry.data.client} · {entry.data.period} · {entry.data.role}
            </p>
            <p>{entry.data.summary}</p>
            <p class="stack">{entry.data.stack.join(' · ')}</p>
          </div>
          <ul class="rail">
            {entry.data.evidence.slice(0, 3).map((item) => (
              <li class="patch reveal" data-tone={item.tone}>
                <span class="value">{item.value}</span>
                <span class="label">{item.label}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>

  <style>
    .head {
      padding-block: clamp(2.5rem, 7vw, 5rem) clamp(1.5rem, 4vw, 3rem);
    }

    .head h1 {
      max-width: 18ch;
      margin-bottom: 1.5rem;
    }

    .lede {
      font-size: 1.1em;
    }

    .list {
      list-style: none;
      /* margin-block only. A `margin: 0` shorthand here would cancel .wrap's
         margin-inline: auto and knock the list out of the page grid. */
      margin-block: 0;
      padding-bottom: clamp(3rem, 8vw, 6rem);
      display: grid;
      gap: 0;
    }

    .list > li {
      border-top: 1px solid var(--rule);
      padding-block: clamp(2rem, 5vw, 3.25rem);
    }

    .thumb {
      display: block;
      margin-bottom: 1.4rem;
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--rule);
      transition: transform 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .thumb:hover {
      transform: translateY(-2px);
    }

    .thumb :global(img) {
      display: block;
      width: 100%;
      height: auto;
      /* Crop to a consistent band so entries with and without a shot line up. */
      aspect-ratio: 16 / 9;
      object-fit: cover;
      object-position: top center;
    }

    .list h2 {
      max-width: 22ch;
      margin-bottom: 0.7rem;
    }

    .list h2 a {
      color: var(--ink);
      text-decoration: none;
    }

    .list h2 a:hover {
      color: var(--forest);
    }

    .meta {
      font-family: var(--label);
      font-size: 0.76rem;
      color: var(--ink-soft);
      margin-bottom: 0.9rem;
    }

    .stack {
      font-family: var(--label);
      font-size: 0.74rem;
      color: var(--ink-soft);
      margin: 1.2rem 0 0;
      max-width: 52ch;
    }
  </style>
</Base>
